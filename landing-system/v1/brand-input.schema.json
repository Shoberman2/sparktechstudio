{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sparktech:landing-brand-input:1.0",
  "title": "SparkTech Landing Brand Input v1",
  "type": "object",
  "required": ["schemaVersion", "companyId", "brand", "audience", "product", "hero", "features", "conversion", "privacy", "footer"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "companyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "brand": {
      "type": "object",
      "required": ["displayName", "logo", "voice", "visualWorld", "tokens"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "logo": { "$ref": "#/$defs/evidenceAsset" },
        "voice": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
        "visualWorld": { "type": "string", "minLength": 20 },
        "tokens": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      }, "additionalProperties": false
    },
    "audience": { "type": "string", "minLength": 10 },
    "product": {
      "type": "object",
      "required": ["name", "summary", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 20 },
        "evidence": { "$ref": "#/$defs/evidenceRefs" }
      }, "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "required": ["hook", "support", "visual", "evidence"],
      "properties": {
        "hook": { "type": "string", "minLength": 10 },
        "support": { "type": "string", "minLength": 20 },
        "visual": { "$ref": "#/$defs/evidenceAsset" },
        "evidence": { "$ref": "#/$defs/evidenceRefs" }
      }, "additionalProperties": false
    },
    "features": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "copy", "visual", "evidence", "syntheticDisclosure"],
        "properties": {
          "title": { "type": "string", "minLength": 8 },
          "copy": { "type": "string", "minLength": 20 },
          "visual": { "$ref": "#/$defs/evidenceAsset" },
          "evidence": { "$ref": "#/$defs/evidenceRefs" },
          "syntheticDisclosure": { "type": ["string", "null"] }
        }, "additionalProperties": false
      }
    },
    "conversion": {
      "type": "object", "required": ["label", "destination", "destinationEvidence"],
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "destination": { "type": "string", "minLength": 2 },
        "destinationEvidence": { "type": "string", "minLength": 2 }
      }, "additionalProperties": false
    },
    "privacy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
    "footer": {
      "type": "object", "required": ["legalEntity", "legalEntityEvidence", "attribution"],
      "properties": {
        "legalEntity": { "type": ["string", "null"] },
        "legalEntityEvidence": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] }
      }, "additionalProperties": false
    }
  },
  "$defs": {
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "evidenceAsset": {
      "type": "object", "required": ["path", "evidence"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "evidence": { "$ref": "#/$defs/evidenceRefs" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
